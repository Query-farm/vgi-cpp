{
  "name": "vgi-cpp",
  "version": "0.1.0",
  "dependencies": [
    {
      "name": "arrow",
      "default-features": false,
      "features": [
        "compute"
      ]
    },
    "curl",
    "libsodium",
    "curl",
    "nlohmann-json",
    "jwt-cpp",
    {
      "name": "cpp-httplib",
      "features": [
        "zstd",
        "zlib",
        "brotli",
        "openssl"
      ]
    },
    "catch2"
  ],
  "features": {
    "s3": {
      "description": "Direct S3 storage (VGI_STORAGE_BACKEND=s3, docs/direct-storage.md); configure with -DVGI_RPC_WITH_S3=ON.",
      "dependencies": [
        {
          "name": "aws-sdk-cpp",
          "default-features": false,
          "features": [
            "s3"
          ]
        }
      ]
    },
    "gcs": {
      "description": "Direct GCS storage (VGI_STORAGE_BACKEND=gcs); configure with -DVGI_RPC_WITH_GCS=ON.",
      "dependencies": [
        {
          "name": "google-cloud-cpp",
          "default-features": false,
          "features": [
            "storage"
          ]
        }
      ]
    }
  }
}
